# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/tanogaido?retryWrites=true&w=majority
MONGODB_URI=

# Payload Secret (Any random 32+ character string used for session encryption)
PAYLOAD_SECRET=tanogaido-super-secret-key-32-characters-minimum

# Canonical site base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret token for on-demand ISR revalidation (/api/revalidate)
REVALIDATE_SECRET=tanogaido-revalidate-secret-token

# Default Admin Credentials used by `npm run seed`
PAYLOAD_ADMIN_USERNAME=admin_tanogaido
PAYLOAD_ADMIN_EMAIL=admin@tanogaido.com
PAYLOAD_ADMIN_PASSWORD=ChangeMeTanogaido2026!
