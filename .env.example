# MongoDB connection string for Payload CMS (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/tanogaido
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tanogaido?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/tanogaido

# Payload CMS secret key (generate a long random string in production)
PAYLOAD_SECRET=replace-with-strong-random-32-char-secret

# Public canonical site URL
NEXT_PUBLIC_SITE_URL=https://tanogaido.com

# Secret token for manual/webhook on-demand ISR revalidation (/api/revalidate)
REVALIDATION_SECRET=replace-with-revalidation-secret

# Seeded Admin Credentials (used by `npm run seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@tanogaido.com
SEED_ADMIN_PASSWORD=TanogaidoAdmin2026!

# ImageKit Media Storage + First-Party Proxy (/media/[...path])
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_FOLDER=tanogaido
